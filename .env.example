# Postgres
POSTGRES_USER=rag_atas_ufes
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag_atas_ufes
POSTGRES_PORT=5433

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# NEO4J_TESTE_BOLT_PORT: Neo4j descartável usado pelo pytest (o de dev nunca é tocado)
NEO4J_TESTE_BOLT_PORT=7688

# Ollama
OLLAMA_PORT=11434

# Geração (Parte 7)
# LLM_PROVEDOR: ollama | anthropic
LLM_PROVEDOR=ollama
# LLM_MODELO: com anthropic, usar um modelo claude-...
LLM_MODELO=qwen2.5:7b
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
# LLM_ESFORCO: só com anthropic (low | medium | high); vazio usa o padrão do modelo
LLM_ESFORCO=
# LLM_NUM_CTX: janela de contexto pedida ao Ollama (o padrão dele, 4096, trunca o prompt)
LLM_NUM_CTX=16384
# ANTHROPIC_API_KEY: só necessário com LLM_PROVEDOR=anthropic
ANTHROPIC_API_KEY=

# CORS_ORIGENS: origens do frontend liberadas na API, em JSON
CORS_ORIGENS=["http://localhost:5173"]

# Ingestion
# ANONYMIZATION_SECRET_KEY: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
ANONYMIZATION_SECRET_KEY=changeme
# ATAS_CORPUS_PATH: machine-specific, points to the local ATAS_UFES/ corpus folder (outside this repo)
ATAS_CORPUS_PATH=/path/to/ATAS_UFES
